#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from std_msgs.msg import String
import tkinter as tk
from tkinter import font as tkfont


class TextCommandGuiNode(Node):
    """
    GUI node to publish natural-language commands to /robot/user_command.

    Features:
    - Text entry box
    - Send button (and Enter key)
    - "Last command sent:" label OUTSIDE the box
    - Only the actual command text appears INSIDE a box, in green, bold
    """

    def __init__(self):
        super().__init__('text_command_gui_node')

        # Publisher
        self.pub = self.create_publisher(String, '/robot/user_command', 10)

        # Window
        self.root = tk.Tk()
        self.root.title("Freeflyer Command Console")
        self.root.resizable(False, False)

        # --- Input section ---
        label = tk.Label(self.root, text="Enter natural-language command:")
        label.pack(padx=10, pady=(10, 0))

        self.text_var = tk.StringVar()
        self.entry = tk.Entry(self.root, textvariable=self.text_var, width=60)
        self.entry.pack(padx=10, pady=5)
        self.entry.focus_set()

        send_button = tk.Button(self.root, text="Send Command", width=20, command=self.on_send)
        send_button.pack(padx=10, pady=(0, 15))

        self.entry.bind("<Return>", lambda event: self.on_send())

        # ----------------------------------------------------------------------
        # Last Command Section
        # ----------------------------------------------------------------------

        # First label OUTSIDE the box
        static_label = tk.Label(self.root, text="Last command sent:")
        static_label.pack(padx=10, pady=(5, 2), anchor="w")

        # Frame for the command text box
        frame = tk.Frame(
            self.root,
            bd=2,
            relief="groove",
            padx=10,
            pady=10,
            bg="#f0f0f0",
        )
        frame.pack(padx=10, pady=(0, 15), fill="x")

        # Font for displayed command
        cmd_font = tkfont.Font(family="Helvetica", size=12, weight="bold")

        # Only the *actual command text* appears in the box
        self.cmd_text_var = tk.StringVar(value="(none yet)")

        self.cmd_label = tk.Label(
            frame,
            textvariable=self.cmd_text_var,
            font=cmd_font,
            fg="green",
            bg="#f0f0f0",
            anchor="w",
            justify="left",
            wraplength=400,
        )
        self.cmd_label.pack(fill="x")

        # Window close callback
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

    def on_send(self):
        text = self.text_var.get().strip()
        if not text:
            return

        # Publish the ROS message
        msg = String()
        msg.data = text
        self.pub.publish(msg)
        self.get_logger().info(f"Published user command: '{text}'")

        # Update only the box text
        self.cmd_text_var.set(text)

        # Clear input and refocus
        self.text_var.set("")
        self.entry.focus_set()

    def on_close(self):
        self.get_logger().info("Shutting down TextCommandGuiNode...")
        self.root.destroy()

    def spin_gui(self):
        self.get_logger().info("TextCommandGuiNode started. GUI ready.")
        self.root.mainloop()


def main(args=None):
    rclpy.init(args=args)
    node = TextCommandGuiNode()
    try:
        node.spin_gui()
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
